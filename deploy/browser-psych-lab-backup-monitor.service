[Unit]
Description=Browser Psych Lab backup freshness monitor
After=browser-psych-lab.service
OnFailure=browser-psych-lab-alert@%N.service
[Service]
Type=oneshot
User=psychlab
Group=psychlab
WorkingDirectory=/opt/browser-psych-lab/current
EnvironmentFile=/etc/browser-psych-lab.env
ExecStart=/opt/node/bin/node /usr/local/bin/psychlab-backup-monitor.mjs
UMask=0077
NoNewPrivileges=true
