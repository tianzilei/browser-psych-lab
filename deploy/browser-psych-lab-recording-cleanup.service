[Unit]
Description=Clean abandoned derived replay downloads
[Service]
Type=oneshot
User=psychlab
Group=psychlab
WorkingDirectory=/opt/browser-psych-lab/current
EnvironmentFile=/etc/browser-psych-lab.env
ExecStart=/opt/node/bin/node dist/server/clean-recording-downloads.js
UMask=0077
Nice=19
CPUQuota=10%
MemoryMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/browser-psych-lab/research-recording-downloads
