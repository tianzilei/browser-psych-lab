NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://study.example
DATABASE_PATH=/var/lib/browser-psych-lab/database/browser-psych-lab.sqlite
STORAGE_ROOT=/var/lib/browser-psych-lab
# Different mounted filesystem, owned by psychlab, private permissions.
BACKUP_ROOT=/mnt/psychlab-backup
LOG_LEVEL=info
# Whole participant sessions: 1 or 2; all others wait before answering.
SESSION_CONCURRENCY=2
# 1 Mbps target: admit one image preparation session at a time (1..4).
PREPARATION_CONCURRENCY=1
# Generate hashes with auth:setup, then copy the hashes to this protected file.
ADMIN_PASSWORD_HASH=
MAINTAINER_PASSWORD_HASH=
