NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://study.example
# Optional direct TLS; configure both together. Leave unset behind a TLS proxy.
# TLS_KEY_PATH=/protected/server-key.pem
# TLS_CERT_PATH=/protected/server.pem
DATABASE_PATH=/var/lib/browser-psych-lab/database/browser-psych-lab.sqlite
STORAGE_ROOT=/var/lib/browser-psych-lab
# Independent target on a different mounted filesystem, owned by psychlab.
# Single-disk hosts that download backups manually set BACKUP_LOCAL_ONLY=1 and
# leave BACKUP_ROOT empty; the job is READY but marked local_only/independent=false.
BACKUP_LOCAL_ONLY=0
BACKUP_ROOT=/mnt/psychlab-backup
# Backup monitor/alerting. Empty webhook/healthcheck means local files + journal only.
BACKUP_FULL_MAX_AGE_HOURS=192
BACKUP_SNAPSHOT_MAX_AGE_HOURS=120
BACKUP_MIN_FREE_GB=8
BACKUP_MIN_FREE_PERCENT=20
# BACKUP_ALERT_WEBHOOK=
# BACKUP_HEALTHCHECK_URL=
# BACKUP_ALERT_HEALTHCHECK_FAIL_URL=
LOG_LEVEL=info
# Once per 24 hours, close sessions with no raw/activity after these TTLs.
# Pinned task permits use the longer permit TTL. 0 disables that branch.
STALE_SESSION_TTL_HOURS=24
STALE_PERMIT_TTL_HOURS=168
# Image/timed-task sessions: floor(0.8 * measured stable capacity). No waiting queue.
# Questionnaires without task groups do not consume these slots.
SESSION_CONCURRENCY=2
# Image preparation: floor(0.8 * measured download capacity), minimum 1.
PREPARATION_CONCURRENCY=1
# Generate the single admin hash with auth:setup, then copy it to this protected file.
ADMIN_PASSWORD_HASH=
